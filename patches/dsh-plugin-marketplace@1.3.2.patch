+  logLine(t(lang, "cloneFallback"));
+  try {
+    await installFromGitHubArchive(repo, cacheDir, { execFileImpl, fetchImpl, platform, logLine, lang });
+    return "archive";
+  } catch (error) {
+    const detail = commandFailureText(error);
+    logLine(t(lang, "archiveAttemptFailed", { format: "all", err: detail }));
+    failures.push(`codeload: ${detail}`);
+    throw new Error(t(lang, "cloneAllFailed", { err: failures.join(" | ").slice(-2400) }));
+  }
+}
