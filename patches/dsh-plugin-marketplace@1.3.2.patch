+      const detail = commandFailureText(error);
+      failures.push(`git ${index + 1}: ${detail}`);
+      logLine(t(lang, "cloneAttemptFailed", { attempt: index + 1, err: detail }));
+      await rm(cacheDir, { recursive: true, force: true }).catch(() => {});
+    }
+  }
