+async function installGitHubRepository(repo, cacheDir, logLine, lang, options = {}) {
+  const execFileImpl = options.execFileImpl ?? execFileAsync;
+  const fetchImpl = options.fetchImpl ?? globalThis.fetch;
+  const platform = options.platform ?? process.platform;
+  const url = `https://github.com/${repo}.git`;
+  const attempts = [
+    ["git", ["clone", "--depth", "1", "--no-tags", url, cacheDir]],
+    ["git", ["-c", "http.version=HTTP/1.1", "-c", "http.maxRequests=1", "clone", "--depth", "1", "--no-tags", url, cacheDir]]
+  ];
+  const failures = [];
+  for (let index = 0; index < attempts.length; index++) {
+    if (index > 0) logLine(t(lang, "cloneRetry", { attempt: index + 1, total: attempts.length }));
+    try {
+      await execFileImpl(attempts[index][0], attempts[index][1], { timeout: GITHUB_CLONE_TIMEOUT_MS });
+      if (!(await exists(cacheDir))) throw new Error("git clone completed without creating the repository directory");
