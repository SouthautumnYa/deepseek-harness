+function commandFailureText(error) {
+  const parts = [error?.stderr, error?.stdout, error?.message]
+    .map((value) => String(value ?? "").trim())
+    .filter(Boolean);
+  return (parts[0] ?? "unknown error").replace(/\s+/g, " ").slice(0, 800);
+}
+
+async function fetchArchiveToFile(url, archivePath, fetchImpl, logLine, lang, format) {
+  if (typeof fetchImpl !== "function") throw new Error("fetch is unavailable");
+  let lastError = null;
+  for (let attempt = 1; attempt <= GITHUB_ARCHIVE_ATTEMPTS; attempt++) {
+    logLine(t(lang, "archiveDownload", { format, attempt, total: GITHUB_ARCHIVE_ATTEMPTS }));
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), GITHUB_ARCHIVE_TIMEOUT_MS);
+    try {
+      const response = await fetchImpl(url, {
+        redirect: "follow",
+        signal: controller.signal,
+        headers: { "user-agent": "dsh-plugin-marketplace", accept: "application/octet-stream" }
+      });
+      if (!response || !response.ok) {
+        throw new Error(`HTTP ${response?.status ?? "unknown"}`);
+      }
+      const bytes = await response.arrayBuffer();
+      if (!bytes || bytes.byteLength === 0) throw new Error("empty archive response");
+      await writeFile(archivePath, Buffer.from(bytes));
+      return;
+    } catch (error) {
+      lastError = error;
+    } finally {
+      clearTimeout(timeout);
+    }
+  }
+  throw lastError ?? new Error("archive download failed");
+}
+
+async function extractArchive(archivePath, extractDir, format, { execFileImpl, platform }) {
+  if (format === "tar.gz") {
+    const commands = platform === "win32" ? ["tar.exe", "tar"] : ["tar"];
+    let lastError = null;
+    for (const command of commands) {
+      try {
+        await execFileImpl(command, ["-xzf", archivePath, "-C", extractDir], {
+          timeout: GITHUB_ARCHIVE_TIMEOUT_MS
+        });
+        return;
+      } catch (error) {
+        lastError = error;
+      }
+    }
+    throw lastError ?? new Error("tar is unavailable");
+  }
+  if (platform !== "win32") throw new Error("zip fallback is only available on Windows");
+  const env = { ...buildMinimalEnv(), DSH_MARKET_ARCHIVE: archivePath, DSH_MARKET_DEST: extractDir };
+  await execFileImpl("powershell.exe", [
+    "-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
+    "-Command",
+    "$ErrorActionPreference='Stop'; Expand-Archive -LiteralPath $env:DSH_MARKET_ARCHIVE -DestinationPath $env:DSH_MARKET_DEST -Force"
+  ], { timeout: GITHUB_ARCHIVE_TIMEOUT_MS, env });
+}
+
+async function copyArchiveRoot(extractDir, cacheDir) {
+  const entries = await readdir(extractDir, { withFileTypes: true });
+  const roots = entries.filter((entry) => entry.isDirectory());
+  if (roots.length !== 1) {
+    throw new Error(`archive has ${roots.length} top-level directories; expected exactly one`);
+  }
+  const root = join(extractDir, roots[0].name);
+  await cp(root, cacheDir, { recursive: true, force: true });
+  if (!(await exists(cacheDir))) throw new Error("archive extraction produced no repository directory");
+}
+
+async function installFromGitHubArchive(repo, cacheDir, { execFileImpl, fetchImpl, platform, logLine, lang }) {
+  const workDir = await mkdtemp(join(tmpdir(), "dsh-marketplace-"));
+  const formats = [
+    { name: "tar.gz", suffix: "tar.gz" },
+    { name: "zip", suffix: "zip" }
+  ];
+  const failures = [];
+  try {
+    for (const format of formats) {
+      const archivePath = join(workDir, `repo.${format.suffix}`);
+      const extractDir = join(workDir, `extract-${format.name.replace(".", "-")}`);
+      await mkdir(extractDir, { recursive: true });
+      try {
+        await fetchArchiveToFile(
+          `https://codeload.github.com/${repo}/${format.suffix}/HEAD`,
+          archivePath,
+          fetchImpl,
+          logLine,
+          lang,
+          format.name
+        );
+        await extractArchive(archivePath, extractDir, format.name, { execFileImpl, platform });
+        await copyArchiveRoot(extractDir, cacheDir);
+        return format.name;
+      } catch (error) {
+        const detail = commandFailureText(error);
+        failures.push(`${format.name}: ${detail}`);
+        logLine(t(lang, "archiveAttemptFailed", { format: format.name, err: detail }));
+        await rm(cacheDir, { recursive: true, force: true }).catch(() => {});
+      }
+    }
+  } finally {
+    await rm(workDir, { recursive: true, force: true }).catch(() => {});
+  }
+  throw new Error(failures.join(" | ") || "no archive fallback succeeded");
+}
